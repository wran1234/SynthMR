{
  "name": "synthmr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "migrate:deploy": "prisma migrate deploy",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "worker": "tsx src/queue/worker.ts",
    "check-population": "tsx scripts/checkPopulation.ts",
    "validate:prod": "tsx scripts/validate-prod.ts",
    "doctor": "tsx scripts/doctor.ts",
    "typecheck": "tsc --noEmit",
    "preflight": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "ioredis": "^5.4.1",
    "jsonrepair": "^3.13.2",
    "lucide-react": "^0.460.0",
    "next": "14.2.18",
    "next-themes": "^0.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "recharts": "^2.13.3",
    "remark-gfm": "^4.0.0",
    "seedrandom": "^3.0.5",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/seedrandom": "^3.0.8",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
