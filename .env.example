# ============================================================================
# SynthMR — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Legend:
#   [REQUIRED]             Must be set in ALL environments (dev + production)
#   [REQUIRED-PRODUCTION]  Must be set in production; has a working default for local dev
#   [RECOMMENDED]          Strongly recommended in production; optional in dev
#   [OPTIONAL]             Has a sensible default; override only if needed
# ============================================================================

# ---------- REQUIRED (all environments) ----------

# Postgres connection string (Docker uses host port 5433)
DATABASE_URL="postgresql://synthmr:synthmr@localhost:5433/synthmr"

# LLM API key — any OpenAI-compatible provider
LLM_API_KEY=your-api-key-here

# ---------- REQUIRED IN PRODUCTION (defaults work for local dev) ----------

# Redis connection string (BullMQ job queue)
# Local default: redis://localhost:6379 (from docker compose)
# Production: set to your managed Redis URL (e.g. Upstash)
REDIS_URL="redis://localhost:6379"

# Base directory for population data (JSONL files, persona folders, soul files)
# Local default: ~/synthmr-data (outside repo so editors don't index large files)
# Production: set to the mounted volume path (e.g. /data on Fly.io)
# DATA_DIR=/Users/you/synthmr-data

# ---------- RECOMMENDED IN PRODUCTION ----------

# 32-byte key for AES-256-GCM encryption of sensitive data at rest.
# Encrypts: Study.ideaText, Study.targetAudienceJson, Aggregate.results,
# AudiencePreset.targetAudienceJson, WebhookEndpoint.secret.
# Generate: openssl rand -base64 32
# Not required — if unset, data is stored in plaintext.
# DATA_ENCRYPTION_KEY_V1=

# Rotation key (set V2 when rotating; decrypt falls back to V1 automatically)
# DATA_ENCRYPTION_KEY_V2=

# Secures GET /api/cron/cleanup (Authorization: Bearer <CRON_SECRET>)
# If unset, the cleanup endpoint is accessible without auth.
# CRON_SECRET=

# Secures GET /api/worker-health (Authorization: Bearer <token>)
# If unset or wrong token → 403 in production.
# WORKER_HEALTH_TOKEN=

# ---------- OPTIONAL: LLM configuration ----------

# OpenAI-compatible base URL (default: https://api.openai.com/v1)
LLM_BASE_URL="https://api.openai.com/v1"

# Model name (default: gpt-4o-mini)
LLM_MODEL="gpt-4o-mini"

# Max concurrent LLM calls (default: 5)
LLM_CONCURRENCY=5

# Per-run LLM call budget (worker reserves slot atomically; run fails if exceeded)
MAX_LLM_CALLS_PER_RUN=5000

# ---------- OPTIONAL: Population ----------

# Population size (default 200000 for dev; set to 1000000 for full runs)
POPULATION_SIZE=200000

# Reuse existing population file for same geography+size (default: true)
POPULATION_REUSE=true

# Full path to population JSONL folder (overrides DATA_DIR/populations)
# POPULATION_DATA_DIR=/Users/you/synthmr-data/populations

# Audience-specific population defaults
AUDIENCE_POPULATION_SIZE_DEFAULT=100000
AUDIENCE_POPULATION_SIZE_MAX=500000

# When sampleSize <= threshold, generate only the sample (no full population file). Default 1000.
FAST_SAMPLE_THRESHOLD=1000

# Direct-sample cache TTL: delete pop_direct_cache_* files older than this many days. Default 14.
DIRECT_SAMPLE_CACHE_TTL_DAYS=14

# ---------- OPTIONAL: Sampling ----------

# Cap on sample size per run (default: 500)
MAX_SAMPLE_SIZE=500
MAX_SAMPLE_SIZE_FREE=300
MAX_SAMPLE_SIZE_PRO=1000

# ---------- OPTIONAL: Worker ----------

# Number of jobs processed in parallel (default: 5, max: 20)
# WORKER_CONCURRENCY=5

# Personas per batch for surveying (default: 25, range: 5–50)
# SIM_BATCH_SIZE=25

# Mark run failed if it exceeds this many minutes (default: 30)
# RUN_TIMEOUT_MINUTES=30

# ---------- OPTIONAL: Features ----------

# Soul update mode: off (default), rare, or on (full)
SOUL_UPDATE_MODE=off

# If true, generate 20 questions instead of 10
FULL_SURVEY=false

# Chat answer cache TTL in days (default: 14)
CHAT_CACHE_TTL_DAYS=14

# ---------- OPTIONAL: Session ----------

# Session cookie expiry in days (default: 30)
SESSION_DAYS=30

# ---------- OPTIONAL: CSRF ----------

# CSRF_COOKIE_NAME=csrf_token
# CSRF_HEADER_NAME=x-csrf-token

# ---------- OPTIONAL: Data retention ----------

# Delete runs older than N days (default: 90). Use with cron calling GET /api/cron/cleanup.
# DATA_RETENTION_DAYS=90

# ---------- OPTIONAL: App ----------

# Public-facing URL (used for OpenGraph, JSON-LD, OpenAPI base)
# NEXT_PUBLIC_APP_URL=https://your-synthmr-domain.com

# Enable interactive API playground at /agents/playground
# ENABLE_API_PLAYGROUND=true
